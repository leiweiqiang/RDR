server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Behind a reverse proxy, avoid absolute redirects to the container IP (http://10.x/home/).
    absolute_redirect off;

    # Strip /api/ and forward to NUXT_API_PROXY_TARGET (query string preserved).
    # e.g. /api/v1/categories?per_page=100 -> ${NUXT_API_PROXY_TARGET}/v1/categories?per_page=100
    location /api/ {
        proxy_pass ${NUXT_API_PROXY_TARGET}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $http_x_api_key;
    }

    location / {
        # Serve /home/index.html for /home (no 301 to add trailing slash).
        try_files $uri $uri/index.html /index.html;
    }
}
