DB_NAME=rdr
DB_USER=rdr
DB_PASSWORD=rdr_password
POSTGRES_PUBLISH_PORT=5433
BACKEND_PUBLISH_PORT=8108
FRONTEND_PUBLISH_PORT=3108
CREATE_SCHEMA_ON_STARTUP=1

# Prefix the public API URL (must match frontend /api proxy). Empty = Swagger expects /openapi.json at site root (fine for direct uvicorn, breaks /api/docs).
API_ROOT_PATH=/api

# Docker Compose profiles: include "dev" so `docker compose up` starts the Nuxt dev server.
# Without this, only postgres + backend start. For nginx static builds use profile "prod".
COMPOSE_PROFILES=dev

FRONTEND_PROD_PUBLISH_PORT=8188
SECRET_KEY=change-this-to-a-long-random-secret

# Frontend API (browser calls /api/... via Nitro proxy in dev, Nginx in prod)
# Can live here or in frontend/.env (Compose loads both via env_file).
NUXT_PUBLIC_API_KEY=your-api-key-here
# Dev Nitro / prod Nginx upstream (strip /api prefix before append):
#   Local backend:  http://backend:8000
#   Remote backend: https://54.177.12.118/rdr-backend/api
NUXT_API_PROXY_TARGET=http://backend:8000
